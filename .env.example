# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Google OAuth credentials for the Continue with Google button.
# Add this production callback URL to the OAuth client in Google Cloud Console:
# https://ravi-ai-chatbot.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=****
AUTH_GOOGLE_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
